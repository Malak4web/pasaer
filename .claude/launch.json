{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "basaer-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "basaer-api",
      "runtimeExecutable": "php",
      "runtimeArgs": ["-d", "upload_max_filesize=256M", "-d", "post_max_size=260M", "-d", "memory_limit=512M", "-S", "127.0.0.1:8000", "-t", "backend/public", "backend/server.php"],
      "port": 8000
    }
  ]
}
